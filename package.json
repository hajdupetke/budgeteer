{
  "name": "budgeteer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait db",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate --sql",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:setup": "pnpm db:up && pnpm db:migrate && pnpm db:generate && pnpm db:seed",
    "vercel-build": "pnpm db:migrate && pnpm db:generate && pnpm build",
    "test": "vitest run tests/finance.test.ts tests/presentation.test.ts",
    "test:integration": "vitest run tests/actions.integration.test.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.9.0",
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.6.0",
    "@radix-ui/react-dialog": "^1.1.11",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.4",
    "@radix-ui/react-popover": "^1.1.11",
    "@radix-ui/react-progress": "^1.1.4",
    "@radix-ui/react-select": "^2.2.2",
    "@radix-ui/react-separator": "^1.1.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@tailwindcss/postcss": "^4.1.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.12.2",
    "lucide-react": "^0.503.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "react": "19.1.0",
    "react-day-picker": "^9.6.7",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.56.1",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.2.0",
    "tw-animate-css": "^1.2.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "postcss": "^8",
    "prisma": "^6.6.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
